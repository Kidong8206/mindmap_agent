{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Context Schema (Stage 2 Output)",
  "description": "Main path and side branches identified per session",
  "type": "object",
  "required": ["session_id", "algorithm", "contexts"],
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^conv_[0-9]{3}$"
    },
    "algorithm": {
      "type": "string",
      "description": "Context analysis algorithm used"
    },
    "contexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["session_num", "main_path", "side_paths"],
        "properties": {
          "session_num": {
            "type": "integer",
            "minimum": 0
          },
          "main_path": {
            "type": "object",
            "required": ["path_id", "turns", "topic", "keywords", "coherence_score"],
            "properties": {
              "path_id": {
                "type": "string",
                "pattern": "^main_[0-9]+$"
              },
              "turns": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "description": "Turn indices in main path (sorted ascending)"
              },
              "topic": {
                "type": "string",
                "minLength": 3,
                "description": "Main topic of the path"
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Key terms in this path"
              },
              "coherence_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Semantic coherence of the path"
              }
            }
          },
          "side_paths": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path_id", "turns", "topic", "keywords", "branch_from_turn", "rejoin_turn"],
              "properties": {
                "path_id": {
                  "type": "string",
                  "pattern": "^side_[0-9]+_[0-9]+$"
                },
                "turns": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "description": "Turn indices in side path"
                },
                "topic": {
                  "type": "string",
                  "minLength": 3,
                  "description": "Side topic"
                },
                "keywords": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "branch_from_turn": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Turn where side path branches off"
                },
                "rejoin_turn": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Turn where side path rejoins main path"
                }
              }
            }
          }
        }
      }
    }
  }
}
