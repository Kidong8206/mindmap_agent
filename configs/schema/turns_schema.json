{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Turns Schema (Stage 0 Output)",
  "description": "Preprocessed conversation turns in JSONL format",
  "type": "object",
  "required": ["session_id", "turns"],
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^conv_[0-9]{3}$",
      "description": "Conversation ID (e.g., conv_001)"
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["turn_id", "role", "text", "timestamp"],
        "properties": {
          "turn_id": {
            "type": "integer",
            "minimum": 0,
            "description": "Sequential turn number starting from 0"
          },
          "role": {
            "type": "string",
            "enum": ["user", "assistant"],
            "description": "Speaker role"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Cleaned and masked conversation text"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp"
          }
        }
      }
    }
  }
}
