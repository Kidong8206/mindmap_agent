{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Keywords Schema (Stage 3 Output)",
  "description": "Extracted keywords from each path",
  "type": "object",
  "required": ["session_id", "algorithm", "keywords_by_path"],
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^conv_[0-9]{3}$"
    },
    "algorithm": {
      "type": "string",
      "description": "Keyword extraction algorithm used"
    },
    "keywords_by_path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path_id", "keywords"],
        "properties": {
          "path_id": {
            "type": "string",
            "pattern": "^(main|side)_[0-9]+(_[0-9]+)?$"
          },
          "keywords": {
            "type": "array",
            "minItems": 3,
            "maxItems": 10,
            "items": {
              "type": "object",
              "required": ["word", "score", "turns"],
              "properties": {
                "word": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Keyword or keyphrase"
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Importance score"
                },
                "turns": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "description": "Turns where this keyword appears"
                }
              }
            }
          }
        }
      }
    }
  }
}
