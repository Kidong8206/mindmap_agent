# ===== OpenAI API Configuration =====
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.0
OPENAI_TIMEOUT=60

# ===== Retry & Rate Limiting =====
MAX_RETRIES=3
RETRY_DELAY=2
MAX_CONCURRENT_REQUESTS=10

# ===== Caching =====
CACHE_ENABLED=true
CACHE_DIR=cache/gpt_responses
CACHE_TTL=604800  # 7 days in seconds

# ===== Experiment Settings =====
PARALLEL_WORKERS=5
DEFAULT_SESSION_ID=conv_001

# ===== Paths =====
DATA_RAW_DIR=data/raw
DATA_GOLDEN_DIR=data/golden
DATA_LABELED_DIR=data/labeled
OUTPUTS_DIR=outputs/runs
CONFIGS_DIR=configs

# ===== Evaluation =====
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask
EMBEDDING_BATCH_SIZE=32

# ===== API Server =====
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ===== Streamlit =====
STREAMLIT_PORT=8501

# ===== Logging =====
LOG_LEVEL=INFO
LOG_FILE=logs/mindmap_lab.log
